# Copy this file to .env for local development (Render: set these in the
# dashboard's Environment tab instead — .env is never committed, it's
# gitignored).

# FireNotification webhook signing secret (from your FN dashboard).
FN_SECRET=

# Supabase project — Project Settings -> API. Use the secret/service_role
# key (full access, bypasses row-level security) — NEVER the anon key for
# this, and never put this key in the HTML file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=

PORT=3001
